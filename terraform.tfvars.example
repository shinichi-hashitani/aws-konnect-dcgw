# =============================================================================
# terraform.tfvars.example
#
# 必要に応じて terraform.tfvars にコピーして上書きしてください:
#   cp terraform.tfvars.example terraform.tfvars
#
# 秘匿情報 (トークン / AWS キー / Kong アカウント ID) は terraform.tfvars には
# 書かず、.env の環境変数 (KONNECT_TOKEN, AWS_*, TF_VAR_kong_ram_principal_account_id)
# で渡すことを推奨します。terraform.tfvars は .gitignore 済みです。
# =============================================================================

project_name = "konnect-dcgw"
aws_region   = "ap-northeast-1"

# Konnect
konnect_server_url = "https://us.api.konghq.com"
control_plane_geo  = "us"
gateway_version    = "3.14"      # 利用可能版: 3.14/3.13/3.12/3.11/3.10/3.4
api_access         = "private"   # 閉塞構成。外部公開する場合のみ private+public / public
base_rps           = 100

# AZ は AZ-ID 形式で指定 (AZ 名ではない)
availability_zone_ids = ["apne1-az1", "apne1-az4"]

# CIDR (相互に重複しないこと)
# Kong ネットワークは prefix /16〜/23 (2 AZ は最小 /23)。
# app-vpc / test-vpc はサブネットを /26 で切り出すため 2 AZ では /24。
network_cidr_block  = "10.0.0.0/23"  # Kong 管理 Cloud Gateway ネットワーク
app_vpc_cidr_block  = "10.1.0.0/24"  # httpbin を配置するアプリ VPC
test_vpc_cidr_block = "10.2.0.0/24"  # テスト実行クライアント用 VPC

# アプリ (httpbin)
app_image          = "kennethreitz/httpbin:latest"
app_container_port = 80

# kong_ram_principal_account_id は .env (TF_VAR_*) 経由での指定を推奨。
# ここに直接書く場合はコミットしないよう注意:
# kong_ram_principal_account_id = "123456789012"
