# =============================================================================
# .env.example
#
# このファイルを .env にコピーして値を埋めてください:
#   cp .env.example .env
# 作業前に環境変数として読み込みます:
#   set -a; source .env; set +a
#
# .env は .gitignore 済みです。絶対にコミットしないでください。
# =============================================================================

# ----- AWS 認証情報 (IAM Identity Center / AWS SSO) -------------------------
# IAM Identity Center で定義したユーザーの SSO プロファイルを使用します。
#
# 1) 初回のみ SSO プロファイルを設定 (対話形式):
#      aws configure sso
#        SSO start URL    : https://<your-portal>.awsapps.com/start
#        SSO region       : <Identity Center のリージョン>
#        アカウント / ロール: 対象を選択
#        CLI default region: ap-northeast-1
#        profile name     : 例) konnect-dcgw
#
# 2) 作業のたびにログイン (トークン期限切れ時も再実行):
#      aws sso login --profile konnect-dcgw
#
# 使用する SSO プロファイル名 (aws configure sso で付けた名前):
export AWS_PROFILE="konnect-dcgw"

# デプロイ対象リージョン (terraform の var.aws_region と一致させること)
export AWS_REGION="ap-northeast-1"

# ----- Kong Konnect 認証情報 -------------------------------------------------
# Personal Access Token (PAT)
#   取得: https://cloud.konghq.com/ -> 右上のアカウント -> "Personal Access Tokens"
#   konnect provider は環境変数 KONNECT_TOKEN を自動的に読み込みます。
export KONNECT_TOKEN="kpat_REPLACE_ME"

# Konnect の geo に対応する API エンドポイント
#   us: https://us.api.konghq.com  /  eu: https://eu.api.konghq.com  ...
#   var.konnect_server_url のデフォルトと一致させてください。
export KONNECT_SERVER_URL="https://us.api.konghq.com"

# ----- Terraform 変数 (TF_VAR_*) --------------------------------------------
# RAM 共有先となる Kong 管理 AWS アカウント ID。
#   1段階目の apply (Konnect ネットワーク作成) 後に Konnect UI で確認します:
#   Konnect -> Gateway Manager -> Networks -> 対象ネットワーク詳細
#   詳細は NETWORKING.md を参照。確認できるまでは空のままで構いません。
export TF_VAR_kong_ram_principal_account_id=""
